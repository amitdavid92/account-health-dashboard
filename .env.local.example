# Copy to .env.local to enable the "Ask the data" chat assistant.
# The rest of the dashboard works with no key at all.
#
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - defaults to gemini-flash-latest (Google's current recommended
# flash model, so this stays current as Google retires older versions).
# GEMINI_MODEL=gemini-flash-latest
